<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget's background shape. It's drawn by an ImageView that the app tints to the
    widget's chosen color (setColorFilter) and fades to its chosen opacity (setImageAlpha).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF202020" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
