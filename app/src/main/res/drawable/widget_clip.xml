<?xml version="1.0" encoding="utf-8"?>
<!--
    Invisible rounded shape on the widget's root view. It isn't drawn (fully transparent);
    it only gives Android 12+ the rounded outline used to clip the picture's corners.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
