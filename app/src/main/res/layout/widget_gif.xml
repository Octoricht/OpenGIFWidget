<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's layout. Only views that RemoteViews supports can be used here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_image_description"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_placeholder" />

    <!-- Temporary label: shows the picked GIF's name and size until animation is added. -->
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:padding="6dp"
        android:text="@string/widget_tap_to_choose"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />

</FrameLayout>
