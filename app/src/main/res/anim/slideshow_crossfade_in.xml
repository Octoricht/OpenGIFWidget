<?xml version="1.0" encoding="utf-8"?>
<!--
    Crossfade, part 1: the new picture fades in during the FIRST half (0-500 ms), then stays solid.
    The flipper draws its children in list order, so the new picture is sometimes on top of the old
    one and sometimes underneath it:
    - on top: this fade is what you see (the old picture is still solid underneath, so no dark dip);
    - underneath: this fade is hidden by the old picture, which then fades away in the second half.
    Either way the screen is always fully covered.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="500"
    android:fromAlpha="0"
    android:interpolator="@android:interpolator/decelerate_quad"
    android:toAlpha="1" />
