<?xml version="1.0" encoding="utf-8"?>
<!--
    Crossfade, part 2: the old picture stays solid for the first half (startOffset), then fades away
    during the SECOND half (500-1000 ms), revealing the new picture, which is already solid by then.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="500"
    android:fromAlpha="1"
    android:interpolator="@android:interpolator/decelerate_quad"
    android:startOffset="500"
    android:toAlpha="0" />
