<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12 and newer (cloud backup and moving to a new phone).
    Same as backup_rules.xml: widget GIFs, frames and settings are never copied.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="gifs/" />
        <exclude domain="file" path="frames/" />
        <exclude domain="sharedpref" path="widgets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="gifs/" />
        <exclude domain="file" path="frames/" />
        <exclude domain="sharedpref" path="widgets.xml" />
    </device-transfer>
</data-extraction-rules>
