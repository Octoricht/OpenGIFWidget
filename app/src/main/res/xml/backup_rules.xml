<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and older.
    Widget GIFs/frames are big (often over the 25 MB backup limit, which makes the whole backup
    fail) and widget ids change on a new phone anyway, so none of the widget data is backed up.
    Restored widgets simply show "Tap to choose a GIF".
-->
<full-backup-content>
    <exclude domain="file" path="gifs/" />
    <exclude domain="file" path="frames/" />
    <exclude domain="sharedpref" path="widgets.xml" />
</full-backup-content>
