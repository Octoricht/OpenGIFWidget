<?xml version="1.0" encoding="utf-8"?>
<!--
    OpenGIFWidget's adaptive icon (Android 8+): the artwork, its background, and a one-color
    version for Android 13+ themed icons. The artwork is scaled to fit the "safe circle" in the
    middle, so no launcher icon shape (circle, squircle, square) can cut it off.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
