    <!-- "How does this work?" guide for making your own shapes -->
    <string name="shape_help_link">How does this work?</string>
    <string name="shape_help_title">Making your own shapes</string>
    <string name="shape_help_intro">Any picture can become a cookie cutter for your widgets.</string>
    <string name="shape_help_step_pick">Pick a picture</string>
    <string name="shape_help_step_cutter">It becomes a cutter</string>
    <string name="shape_help_step_widget">Your GIF shows inside</string>
    <string name="shape_help_find_title">Where do I find shapes?</string>
    <string name="shape_help_find_text">You don\'t have to draw anything! Pinterest is full of them: search for \"shape\", \"shape stencil\" or \"silhouette\". Any picture from Google Images or your gallery works too.</string>
    <string name="shape_help_examples_title">Which part becomes the shape?</string>
    <string name="shape_help_examples_intro">It depends on the kind of picture. The app checks it for you.</string>
    <string name="shape_help_transparent_title">Pictures with transparent parts</string>
    <string name="shape_help_transparent_text">Like stickers and PNGs: the transparent parts decide.</string>
    <string name="shape_help_transparent_example">The transparent parts are cut away, everything else is the shape.</string>
    <string name="shape_help_dark_title">Pictures without transparency</string>
    <string name="shape_help_dark_text">Like drawings and photos: how dark each part is decides.</string>
    <string name="shape_help_black_text">Black is the shape, white is cut away. In color photos, the dark parts become the shape.</string>
    <string name="shape_help_gray_text">Gray is half transparent, so your picture fades out softly there.</string>
    <string name="shape_help_got_it">Got it</string>
    <string name="shape_help_try_title">Try it yourself!</string>
    <string name="shape_help_try_text">Here\'s a black and white picture of a cat. Let\'s turn it into a shape, just like you would with your own picture.</string>
    <string name="shape_help_try_picture">A black cat head on white</string>
    <string name="shape_help_try_button">Make a shape from this cat</string>
    <string name="tutorial_making_hint">The app is looking at the picture: the black cat stays, the white around it gets cut away.</string>
    <string name="tutorial_preview_hint">Here\'s your cutter! The black cat became the shape, and the white around it was cut away (the checkered part). Tap Use this shape to keep it.</string>
    <string name="tutorial_done_title">Your cat shape is ready!</string>
    <string name="tutorial_done_editor">It\'s on your widget\'s preview now. Tap %1$s to keep it. You\'ll always find it in the Shape row.</string>
    <string name="tutorial_done_settings">You\'ll find it in every widget\'s Shape row. Now try it with your own pictures!</string>
