    <string name="editor_speed_reset">Reset</string>
    <string name="editor_speed_fps">Plays at about %1$d fps. The FPS cap (%2$d) can be changed in Settings.</string>

    <!-- Settings screen -->
    <string name="settings_title">Settings</string>
    <string name="settings_back">Back</string>
    <string name="settings_animation">Animation</string>
    <string name="settings_fps_cap">FPS cap</string>
    <string name="settings_fps_cap_description">The fastest any widget will play. Lower values save battery and keep your home screen smooth. Changing it updates all your widgets right away.</string>
    <string name="settings_about">About</string>
    <string name="about_description">Picture, GIF &amp; video widgets, open source, no ads</string>
    <string name="about_version">Version %1$s</string>
