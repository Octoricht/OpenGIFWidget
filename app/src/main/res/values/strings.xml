    <string name="settings_fps_cap_description">The fastest any widget will play. Lower values save battery and keep your home screen smooth. Changing it updates all your widgets right away.</string>
    <string name="settings_fps_cap_device_limit">Your phone works best at up to %1$d fps, so higher caps are turned off.</string>
    <string name="settings_reliability">Reliability</string>
    <string name="settings_battery_title">A widget stopped animating?</string>
    <string name="settings_battery_text">Some phones stop apps in the background to save battery, which can freeze widgets. If that happens, let OpenGIFWidget run without restrictions:\n\n• Samsung: App info › Battery › Unrestricted\n• Xiaomi, Redmi, POCO: App info › Autostart on, and Battery saver › No restrictions\n• OnePlus, OPPO, realme: App info › Battery usage › Allow background activity\n• Huawei, Honor: Battery › App launch › OpenGIFWidget › Manage manually\n\nRestarting your phone also redraws every widget.</string>
    <string name="settings_battery_button">Open battery settings</string>
